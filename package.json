{
  "name": "manhunt-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "sync": "npm run build && cap sync",
    "android": "cap open android",
    "ios": "cap open ios",
    "build:release": "vue-tsc --noEmit && vite build --mode release"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0",
    "vue": "^3.5.0",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@types/leaflet": "^1.9.0",
    "typescript": "~5.9.0",
    "vite": "^7.3.0",
    "vue-tsc": "^3.0.0",
    "vitest": "^4.0.0",
    "@types/node": "^24.0.0"
  }
}
